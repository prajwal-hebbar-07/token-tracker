{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Tracker",
  "version": "0.1.0",
  "identifier": "com.tokentracker.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "beforeBuildCommand": "pnpm --filter @token-tracker/web run build",
    "beforeDevCommand": "pnpm --filter @token-tracker/web run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
